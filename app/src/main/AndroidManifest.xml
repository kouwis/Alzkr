            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_custom" />
        </receiver>
        <receiver android:name=".widget.WidgetTickReceiver" android:exported="false" />
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Alzkr">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
            <receiver
            android:name=".widget.LockDayWidgetReceiver"
