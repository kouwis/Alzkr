            <meta-data android:name="samsung.appwidget.monotone.info" android:resource="@xml/samsung_lock_dhikr" />
        </receiver>
        <!-- Samsung's lock-screen widgets -->
        <meta-data android:name="SamsungBasicInteraction" android:value="SEP10" />
        <!-- the widgets' pictures, read by the home screen -->
        <provider
            android:name=".widget.WidgetImageProvider"
            android:authorities="${applicationId}.widgetimg"
            android:exported="true" />
    </application>
</manifest>
