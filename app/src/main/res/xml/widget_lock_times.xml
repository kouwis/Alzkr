<?xml version="1.0" encoding="utf-8"?>
<!-- A Samsung lock-screen (and always-on display) widget: small, drawn as a capsule by the phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:description="@string/widget_lock_times_desc"
    android:initialLayout="@layout/lock_times"
    android:previewLayout="@layout/lock_times_preview"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:resizeMode="none"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="keyguard|home_screen"
    app:initialLayoutSmall="@layout/lock_times"
    app:previewLayoutSmall="@layout/lock_times_preview"
    app:monotoneInitialLayout="@layout/lock_times"
    app:monotonePreviewLayout="@layout/lock_times_preview"
    app:monotoneInitialLayoutSmall="@layout/lock_times"
    app:monotonePreviewLayoutSmall="@layout/lock_times_preview"
    app:lockWidgetSize="small"
    app:monotoneWidgetSize="small"
    app:widgetSize="small"
    app:targetHost="lockAndAod"
    app:widgetStyle="colorful|monotone" />
