<?xml version="1.0" encoding="utf-8"?>
<!-- A Samsung lock-screen (and always-on display) widget: small, drawn as a capsule by the phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:minWidth="56dp"
    android:minHeight="56dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/lock_times"
    android:previewLayout="@layout/lock_times"
    android:resizeMode="none"
    android:description="@string/widget_lock_times_desc"
    android:widgetCategory="keyguard"
    app:targetHost="lockAndAod"
    app:widgetStyle="colorful|monotone"
    app:lockWidgetSize="small"
    app:monotoneWidgetSize="small" />
